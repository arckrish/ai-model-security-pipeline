# Copy to .env and fill in (gitignored). Sourced by gitops-scripts.sh.
#   cp .env.example .env

# Hugging Face (gated models) — model-ingress hf-token secret
HF_TOKEN=

# Quay pull/push (docker-registry secret)
QUAY_SERVER=quay.io
QUAY_USERNAME=
QUAY_PASSWORD=
QUAY_EMAIL=
QUAY_SECRET_NAME=sudash-modelpipeline-pull-secret
# ModelCar repo without tag (Job + PipelineRun must match). Example:
# MODELCAR_IMAGE=quay.io/${QUAY_USERNAME}/modelcar-redhatai-qwen3-8b-fp8-dynamic
MODELCAR_IMAGE=

# MinIO root + zone S3 credentials (minio-root + minio-s3 secrets)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
